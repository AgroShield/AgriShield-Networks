# Copy to .env and fill in. Every value here is required unless marked optional;
# the backend refuses to start rather than defaulting a contract address, because
# a backend pointed at the wrong registry would answer confidently and wrongly.

# --- Network -----------------------------------------------------------------
# A Soroban RPC endpoint, e.g. https://soroban-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# testnet | mainnet | futurenet | local. Defaults to testnet.
SOROBAN_NETWORK=testnet
# Only needed for a network not listed above; overrides SOROBAN_NETWORK.
# SOROBAN_NETWORK_PASSPHRASE=Standalone Network ; February 2017

# --- Contract addresses ------------------------------------------------------
POLICY_REGISTRY_CONTRACT_ID=C...
PAYOUT_ENGINE_CONTRACT_ID=C...
PREMIUM_POOL_CONTRACT_ID=C...
ORACLE_ADAPTER_CONTRACT_ID=C...

# --- Read access -------------------------------------------------------------
# Source account for read-only simulations. Simulation ignores the sequence
# number, so this account does not need to exist or to be funded. Optional when
# KEEPER_SECRET_KEY is set, in which case the keeper's public key is used.
SOROBAN_READ_SOURCE=G...

# --- Keeper ------------------------------------------------------------------
# The signing key that submits settlements. Omit it entirely to run a read-only
# API: every query still works, but POST /settlements/:policyId returns 503.
# KEEPER_SECRET_KEY=S...
# Set to false to pause the keeper without removing the key.
KEEPER_ENABLED=true
# How often a sweep runs, in milliseconds. 1000..3600000.
KEEPER_INTERVAL_MS=30000
# How many policies one sweep examines. 1..500.
KEEPER_BATCH_SIZE=25

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=3000
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
