# Copy to .env and fill in. Both values are optional: the defaults are what a
# local `pnpm dev:backend` plus `pnpm dev:frontend` pair needs.

# Where the browser sends API requests. Defaults to `/api`, a same-origin path
# the Vite dev server proxies and a reverse proxy serves in production. Set an
# absolute URL to call the API directly, but note that the backend sets no CORS
# headers, so that origin has to be allowed in front of it.
# VITE_API_BASE_URL=/api

# Where the dev server proxies `/api` to. Development only.
# VITE_API_PROXY_TARGET=http://localhost:3000
